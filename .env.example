POSTGRES_USER=suporte
POSTGRES_PASSWORD=suporte_password
POSTGRES_DB=centralsuporte_db

# Chave de assinatura dos tokens JWT. Gere com: openssl rand -hex 32
SECRET_KEY=
# Senha do usuário "admin" criado no primeiro start (só vale na criação)
DEFAULT_ADMIN_PASSWORD=

# Web Push (notificações com a Central fechada). Gere com:
#   docker run --rm centralsuporte-backend python -m app.services.push >> .env
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@exemplo.com
